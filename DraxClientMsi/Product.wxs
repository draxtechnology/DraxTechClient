<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Drax Technology Client"
           Manufacturer="Drax Technology"
           Version="1.0.1"
           UpgradeCode="BCDEEC3D-DD83-44D7-9AC4-783B277ECBC5"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="Drax Technology Client"
                        Keywords="Installer,Drax,Client" />

    <MajorUpgrade DowngradeErrorMessage="A later version of [ProductName] is already installed." />

    <Media Id="1" Cabinet="files.cab" EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DraxClient.ico" SourceFile="..\Drax360Client\DT-small.ico" />
    <Property Id="ARPPRODUCTICON" Value="DraxClient.ico" />

    <!-- The client resolves which service instance it fronts from the
         instance launch argument (Program.InstanceNumber; missing = 1).
         The engineer picks the instance(s) at install time on the feature
         tree: each instance feature installs a Start Menu + Desktop shortcut
         pair carrying the matching argument. Instance 1 is on by default and
         keeps the original unsuffixed shortcuts (no argument = instance 1);
         2-4 are off by default (Level 2 > default INSTALLLEVEL) and can be
         added later via Programs and Features -> Change. Mirrors the service
         MSI's per-instance feature picker. -->
    <Feature Id="Main" Title="Drax Client" Level="1" AllowAbsent="no" AllowAdvertise="no">
      <ComponentGroupRef Id="ClientComponents" />
      <ComponentGroupRef Id="DependencyFiles" />
    </Feature>
    <!-- Shortcut features are driven by the INSTANCENUM radio prompt (same
         prompt as the service MSI); "OR !FeatureN = 3" keeps already-installed
         instance shortcuts when setup is re-run to add another. -->
    <Feature Id="ClientInstance1" Title="Shortcuts — Service Instance 1"
             Description="Start Menu and Desktop shortcuts for the instance-1 service (C:\AMX1)."
             Level="2" Display="hidden" AllowAdvertise="no">
      <Level Value="1" Condition="INSTANCENUM = &quot;1&quot; OR !ClientInstance1 = 3" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
    <Feature Id="ClientInstance2" Title="Shortcuts — Service Instance 2"
             Description="Start Menu and Desktop shortcuts launching the client against the instance-2 service (C:\AMX2)."
             Level="2" Display="hidden" AllowAdvertise="no">
      <Level Value="1" Condition="INSTANCENUM = &quot;2&quot; OR !ClientInstance2 = 3" />
      <ComponentRef Id="StartMenuShortcutComponent2" />
      <ComponentRef Id="DesktopShortcutComponent2" />
    </Feature>
    <Feature Id="ClientInstance3" Title="Shortcuts — Service Instance 3"
             Description="Start Menu and Desktop shortcuts launching the client against the instance-3 service (C:\AMX3)."
             Level="2" Display="hidden" AllowAdvertise="no">
      <Level Value="1" Condition="INSTANCENUM = &quot;3&quot; OR !ClientInstance3 = 3" />
      <ComponentRef Id="StartMenuShortcutComponent3" />
      <ComponentRef Id="DesktopShortcutComponent3" />
    </Feature>
    <Feature Id="ClientInstance4" Title="Shortcuts — Service Instance 4"
             Description="Start Menu and Desktop shortcuts launching the client against the instance-4 service (C:\AMX4)."
             Level="2" Display="hidden" AllowAdvertise="no">
      <Level Value="1" Condition="INSTANCENUM = &quot;4&quot; OR !ClientInstance4 = 3" />
      <ComponentRef Id="StartMenuShortcutComponent4" />
      <ComponentRef Id="DesktopShortcutComponent4" />
    </Feature>

    <!-- Default install location: C:\AMX1\ — user can change this in the installer UI -->
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="INSTALLFOLDER" Name="AMX1" />
    </DirectoryRef>

    <!-- Start Menu folder: Drax -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="DraxStartMenu" Name="Drax" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Main client EXE component -->
    <ComponentGroup Id="ClientComponents" Directory="INSTALLFOLDER">
      <Component Id="DraxClientExe" Guid="C9D4E5F6-A7B8-9C0D-1E2F-3A4B5C6D7E8F">
        <File Id="DraxClient.exe"
              Source="$(var.DraxClient.TargetDir)DraxClient.exe"
              KeyPath="yes" />
      </Component>
      <!-- DT-small.ico is embedded in the EXE and registered in the MSI's
           internal Icon table (line 19) for ARPPRODUCTICON + the Start
           Menu / Desktop shortcuts. No separate deployed copy is needed
           in the install folder. -->
    </ComponentGroup>

    <!-- Start Menu shortcut (own component for clean uninstall of the folder) -->
    <Component Id="StartMenuShortcutComponent"
               Directory="DraxStartMenu"
               Guid="E1F2A3B4-C5D6-E7F8-A9B0-C1D2E3F4A5B6">
      <Shortcut Id="StartMenuShortcut"
                Name="Drax Technology Client"
                Description="Drax Technology Client"
                Target="[INSTALLFOLDER]DraxClient.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DraxClient.ico" />
      <RemoveFolder Id="RemoveDraxStartMenu" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Drax\DraxClient"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut -->
    <Component Id="DesktopShortcutComponent"
               Directory="DesktopFolder"
               Guid="F2A3B4C5-D6E7-F8A9-B0C1-D2E3F4A5B6C7">
      <Shortcut Id="DesktopShortcut"
                Name="Drax Technology Client"
                Description="Drax Technology Client"
                Target="[INSTALLFOLDER]DraxClient.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DraxClient.ico" />
      <RegistryValue Root="HKCU"
                     Key="Software\Drax\DraxClient"
                     Name="DesktopShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Instance 2-4 shortcut pairs — same exe; the instance argument picks
         the service pipe pair the client fronts (PipeProtocol.SendPipeName). -->
    <Component Id="StartMenuShortcutComponent2"
               Directory="DraxStartMenu"
               Guid="7A1B2C3D-4E5F-6071-8293-A4B5C6D7E8F9">
      <Shortcut Id="StartMenuShortcut2"
                Name="Drax Technology Client 2"
                Description="Drax Technology Client — service instance 2"
                Target="[INSTALLFOLDER]DraxClient.exe"
                Arguments="--instance 2"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DraxClient.ico" />
      <RemoveFolder Id="RemoveDraxStartMenu2" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Drax\DraxClient"
                     Name="StartMenuShortcut2"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
    <Component Id="DesktopShortcutComponent2"
               Directory="DesktopFolder"
               Guid="8B2C3D4E-5F60-7182-93A4-B5C6D7E8F901">
      <Shortcut Id="DesktopShortcut2"
                Name="Drax Technology Client 2"
                Description="Drax Technology Client — service instance 2"
                Target="[INSTALLFOLDER]DraxClient.exe"
                Arguments="--instance 2"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DraxClient.ico" />
      <RegistryValue Root="HKCU"
                     Key="Software\Drax\DraxClient"
                     Name="DesktopShortcut2"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
    <Component Id="StartMenuShortcutComponent3"
               Directory="DraxStartMenu"
               Guid="9C3D4E5F-6071-8293-A4B5-C6D7E8F90112">
      <Shortcut Id="StartMenuShortcut3"
                Name="Drax Technology Client 3"
                Description="Drax Technology Client — service instance 3"
                Target="[INSTALLFOLDER]DraxClient.exe"
                Arguments="--instance 3"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DraxClient.ico" />
      <RemoveFolder Id="RemoveDraxStartMenu3" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Drax\DraxClient"
                     Name="StartMenuShortcut3"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
    <Component Id="DesktopShortcutComponent3"
               Directory="DesktopFolder"
               Guid="AD4E5F60-7182-93A4-B5C6-D7E8F9011223">
      <Shortcut Id="DesktopShortcut3"
                Name="Drax Technology Client 3"
                Description="Drax Technology Client — service instance 3"
                Target="[INSTALLFOLDER]DraxClient.exe"
                Arguments="--instance 3"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DraxClient.ico" />
      <RegistryValue Root="HKCU"
                     Key="Software\Drax\DraxClient"
                     Name="DesktopShortcut3"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
    <Component Id="StartMenuShortcutComponent4"
               Directory="DraxStartMenu"
               Guid="BE5F6071-8293-A4B5-C6D7-E8F901122334">
      <Shortcut Id="StartMenuShortcut4"
                Name="Drax Technology Client 4"
                Description="Drax Technology Client — service instance 4"
                Target="[INSTALLFOLDER]DraxClient.exe"
                Arguments="--instance 4"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DraxClient.ico" />
      <RemoveFolder Id="RemoveDraxStartMenu4" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Drax\DraxClient"
                     Name="StartMenuShortcut4"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
    <Component Id="DesktopShortcutComponent4"
               Directory="DesktopFolder"
               Guid="CF607182-93A4-B5C6-D7E8-F90112233445">
      <Shortcut Id="DesktopShortcut4"
                Name="Drax Technology Client 4"
                Description="Drax Technology Client — service instance 4"
                Target="[INSTALLFOLDER]DraxClient.exe"
                Arguments="--instance 4"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DraxClient.ico" />
      <RegistryValue Root="HKCU"
                     Key="Software\Drax\DraxClient"
                     Name="DesktopShortcut4"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- The instance prompt, mirroring the service MSI. Defaults to 1 so a
         silent install (msiexec /qn, optionally INSTANCENUM=n) needs no UI.
         Fresh install: Welcome → instance prompt → install folder → Ready
         (license page skipped — no agreed EULA text yet; restore later by
         removing these publishes and supplying WixUILicenseRtf). Maintenance:
         Change → instance prompt to add another instance's shortcuts. -->
    <Property Id="INSTANCENUM" Value="1" Secure="yes" />
    <UI>
      <Dialog Id="InstanceDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="290" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Service instance" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose which network manager instance this client fronts." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Instances" Type="RadioButtonGroup" Property="INSTANCENUM" X="35" Y="65" Width="300" Height="100">
          <RadioButtonGroup Property="INSTANCENUM">
            <RadioButton Value="1" X="0" Y="0" Width="290" Height="16" Text="Instance 1   (service in C:\AMX1)" />
            <RadioButton Value="2" X="0" Y="20" Width="290" Height="16" Text="Instance 2   (service in C:\AMX2)" />
            <RadioButton Value="3" X="0" Y="40" Width="290" Height="16" Text="Instance 3   (service in C:\AMX3)" />
            <RadioButton Value="4" X="0" Y="60" Width="290" Height="16" Text="Instance 4   (service in C:\AMX4)" />
          </RadioButtonGroup>
        </Control>
        <Control Id="Note" Type="Text" X="35" Y="170" Width="300" Height="30" Transparent="yes" NoPrefix="yes" Text="Shortcuts for instances already on this machine stay installed — running setup again adds the chosen instance alongside them." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstanceDlg" Order="99" Condition="NOT Installed" />
      <Publish Dialog="InstanceDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Condition="NOT Installed" />
      <Publish Dialog="InstanceDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Condition="Installed" />
      <Publish Dialog="InstanceDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="NOT Installed" />
      <Publish Dialog="InstanceDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="InstanceDlg" Order="99" Condition="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstanceDlg" Order="99" Condition="WixUI_InstallMode = &quot;Change&quot;" />
      <Publish Dialog="MaintenanceTypeDlg" Control="ChangeButton" Event="NewDialog" Value="InstanceDlg" Order="99" Condition="1" />
    </UI>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>

</Wix>
